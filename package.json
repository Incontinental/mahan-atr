{
  "name": "mahan-atar-store",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "prisma generate --schema=./prisma/schema.prisma && next build",
    "start": "next start -H 0.0.0.0",
    "db:push": "prisma db push --schema=./prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "jose": "^6.1.0",
    "next": "^15.5.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.12",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "prisma": "^6.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "prisma": {
    "schema": "./prisma/schema.prisma"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "allowScripts": {
    "@prisma/client": true,
    "prisma": true,
    "@prisma/engines": true,
    "esbuild": true
  }
}
